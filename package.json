{
  "name": "@mago-foundation/mago-ski",
  "version": "0.1.0",
  "description": "Skills PKI: organization-approved, exact-version Skill certificates enforced on the agent host",
  "keywords": [
    "pi-package",
    "agent-skills",
    "skills",
    "pki",
    "supply-chain",
    "signing"
  ],
  "homepage": "https://magofoundation.dev",
  "bugs": {
    "url": "https://github.com/mago-foundation/mago-ski/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mago-foundation/mago-ski.git"
  },
  "license": "Apache-2.0",
  "author": "The Mago Foundation",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "mago-ski": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/spec",
    "docs/hosts/",
    "docs/threat-model.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.20.4",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.4"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "pi": {
    "extensions": [
      "./dist/hosts/pi/index.js"
    ]
  }
}
